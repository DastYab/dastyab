<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dastyabBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_card_background"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/icon_badge_bg"
                    android:padding="9dp"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_action_dns_blackout"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rescue_title"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="?attr/dastyabAccent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rescue_subtitle"
                        android:textSize="12sp"
                        android:textColor="?attr/dastyabTextSecondary"
                        android:paddingTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/rescueProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateTint="?attr/dastyabAccent"
                android:progressBackgroundTint="?attr/dastyabDivider"
                android:visibility="gone"
                android:paddingTop="10dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- 1. SMART 5-STAGE CONFIG HARVESTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_harvester_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent" />

            <TextView
                android:id="@+id/tvHarvestSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_harvester_hint"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingTop="4dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnRunHarvest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_btn_harvest"
                style="@style/DastyabButtonPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <Button
                    android:id="@+id/btnPickHarvested"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rescue_btn_pick_configs"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnSetBootstrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rescue_btn_bootstrap"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <Button
                android:id="@+id/btnOpenFileVault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/rescue_btn_file_vault"
                style="@style/DastyabButton" />

            <Button
                android:id="@+id/btnOpenSourceManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/rescue_btn_manage_sources"
                style="@style/DastyabButton" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 2. EMERGENCY DNS BLACKOUT VPN (WhiteDNS / DoH / SlipNet) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_dns_vpn_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_dns_vpn_hint"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingTop="4dp"
                android:paddingBottom="10dp" />

            <Spinner
                android:id="@+id/spinnerDohPreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:background="@drawable/input_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <EditText
                android:id="@+id/etDnsTunnelDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/rescue_dns_tunnel_hint"
                android:textColor="?attr/dastyabTextPrimary"
                android:textColorHint="?attr/dastyabTextSecondary"
                android:textSize="13sp"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:inputType="textUri" />

            <Button
                android:id="@+id/btnActivateDnsBlackout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/rescue_btn_activate_dns_vpn"
                style="@style/DastyabButtonPrimary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 3. IP RANGE SCOUT & CLEAN DNS SCANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_scout_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_scout_hint"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingTop="4dp"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnScoutEdgeIps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rescue_btn_scout_ips"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnScoutCleanDns"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rescue_btn_scout_dns"
                    style="@style/DastyabButton" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 4. SMART CONNECTIVITY TROUBLESHOOTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_troubleshoot_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent" />

            <TextView
                android:id="@+id/tvDiagnosisHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_troubleshoot_hint"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingTop="4dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnRunTroubleshoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_btn_troubleshoot"
                style="@style/DastyabButton" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 5. FALLBACK VPNS & COMMUNITY ANTI-CENSORSHIP TOOLS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_fallbacks_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_fallbacks_hint"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingTop="4dp"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/fallbackToolsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- LIVE RESCUE OUTPUT LOG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_log_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tvRescueLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescue_log_empty"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="?attr/dastyabTextPrimary"
                android:textIsSelectable="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <Button
            android:id="@+id/btnRescueBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/browser_btn_back"
            style="@style/DastyabButton" />
    </LinearLayout>
</ScrollView>
