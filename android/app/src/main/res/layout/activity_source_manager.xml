<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dastyabBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_card_background"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/source_mgr_title"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/source_mgr_subtitle"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingTop="4dp" />

            <ProgressBar
                android:id="@+id/sourceMgrProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateTint="?attr/dastyabAccent"
                android:progressBackgroundTint="?attr/dastyabDivider"
                android:visibility="gone"
                android:paddingTop="10dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- CARD 1: HARVEST, PROTOCOL FILTER, LATENCY TEST & ONE-TAP EXPORT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/source_mgr_harvest_card_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_mgr_protocol_label"
                    android:textSize="13sp"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:paddingEnd="10dp" />

                <Spinner
                    android:id="@+id/spinnerProtocolFilter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRunUnifiedHarvest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_harvest"
                    style="@style/DastyabButtonPrimary" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnTestLatency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_test_latency"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHarvestStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabTextPrimary"
                android:paddingTop="10dp" />

            <TextView
                android:id="@+id/tvHarvestLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="?attr/dastyabTextSecondary"
                android:textIsSelectable="true"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <!-- One-Tap Export & Client Share -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/source_mgr_export_label"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabTextPrimary"
                android:paddingTop="4dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnExportCopyAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_copy_all"
                    android:textSize="12sp"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnExportSubB64"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_copy_sub"
                    android:textSize="12sp"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnExportQr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_qr"
                    android:textSize="12sp"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnShareV2rayNg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_share_v2rayng"
                    android:textSize="12sp"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnShareHiddify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_share_hiddify"
                    android:textSize="12sp"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnShareNekoBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_share_nekobox"
                    android:textSize="12sp"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/resultsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- CARD 2: UNIFIED SOURCE LIST MANAGER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/source_mgr_sources_card_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent" />

            <TextView
                android:id="@+id/tvSourcesSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingTop="4dp"
                android:paddingBottom="10dp" />

            <!-- Source Type Filter Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/source_mgr_filter_all"
                        android:textSize="12sp"
                        style="@style/DastyabButtonPrimary" />

                    <View android:layout_width="6dp" android:layout_height="0dp" />

                    <Button
                        android:id="@+id/btnFilterGithub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/source_mgr_filter_github"
                        android:textSize="12sp"
                        style="@style/DastyabButton" />

                    <View android:layout_width="6dp" android:layout_height="0dp" />

                    <Button
                        android:id="@+id/btnFilterSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/source_mgr_filter_sub"
                        android:textSize="12sp"
                        style="@style/DastyabButton" />

                    <View android:layout_width="6dp" android:layout_height="0dp" />

                    <Button
                        android:id="@+id/btnFilterTgChan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/source_mgr_filter_tg_chan"
                        android:textSize="12sp"
                        style="@style/DastyabButton" />

                    <View android:layout_width="6dp" android:layout_height="0dp" />

                    <Button
                        android:id="@+id/btnFilterTgPost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/source_mgr_filter_tg_post"
                        android:textSize="12sp"
                        style="@style/DastyabButton" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- CRUD Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnAddSource"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_add"
                    android:textSize="12sp"
                    style="@style/DastyabButtonPrimary" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnBulkPaste"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_bulk"
                    android:textSize="12sp"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <Button
                    android:id="@+id/btnImportSources"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_import"
                    android:textSize="12sp"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnExportSources"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_mgr_btn_export"
                    android:textSize="12sp"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnResetSourcesDefaults"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sources_btn_reset"
                    android:textSize="12sp"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sourcesListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <Button
            android:id="@+id/btnSourceMgrBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/browser_btn_back"
            style="@style/DastyabButton" />
    </LinearLayout>
</ScrollView>
